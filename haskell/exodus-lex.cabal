cabal-version:      2.2
name:               exodus-lex
version:            0.1.0.0
category:           Language
synopsis:           Haskell bindings to Exodus's HolyC lexer bridge
description:
  Drives the HolyC `Lex` routine via Exodus's C bridge and returns the
  full token stream as a Haskell list.
  .
  Requires libexodus_lex (built by the Exodus CMake project with
  -DBUILD_EXODUS_LEX_SHARED=ON, default ON) to be available at link
  and run time.
-- same terms as Exodus itself (zlib), see the upstream LICENSE
license:            Zlib
author:             Exodus contributors
maintainer:         exodus@example.invalid
build-type:         Simple

-- libexodus_lex has to be found twice, by the linker and by the loader.
-- from the haskell/ directory of an Exodus checkout that was built into
-- build/, both are covered by
--
--   cabal build --extra-lib-dirs=$PWD/../build/src/exodus
--   LD_LIBRARY_PATH=$PWD/../build/src/exodus \
--     cabal run exodus-lex-demo -- ../T ../HCRT.BIN
--
-- (PATH on Windows, DYLD_LIBRARY_PATH on macOS). the demo takes the
-- T root and the HCRT image as arguments, T and HCRT.BIN in the
-- current directory if you leave them out.

library
  hs-source-dirs:     .
  exposed-modules:    Exodus.Lex
  default-language:   Haskell2010
  build-depends:      base >= 4.12 && < 5
  extra-libraries:    exodus_lex
  ghc-options:        -Wall

executable exodus-lex-demo
  hs-source-dirs:     demo
  main-is:            Main.hs
  default-language:   Haskell2010
  build-depends:      base, exodus-lex
  ghc-options:        -Wall -threaded
